LIBNAME CHIS1516 "~DATA LOCATION FOR CHIS 2015-2016 DATA";
LIBNAME CHIS17  "~DATA LOCATION FOR CHIS 2017 DATA";
LIBNAME CHIS18  "~DATA LOCATION FOR CHIS 2018 DATA";
LIBNAME CHIS19  "~DATA LOCATION FOR CHIS 2019 DATA";
DATA CHIS1516;
	SET CHIS1516.ADULT;
RUN;

DATA CHIS17;
	SET CHIS17.ADULT;
RUN;

DATA CHIS18;
	SET CHIS18.ADULT;
RUN;

DATA CHIS19;
	SET CHIS19.ADULT;
RUN;

DATA COMBINED;
	LENGTH YEAR $8;
	SET 
		CHIS1516 (IN = A)
		CHIS17 (IN = B)
		CHIS18 (IN = C)
		CHIS19 (IN = D);
	IF A THEN YEAR = "2015_16";
	ELSE IF B THEN YEAR = "2017";
	ELSE IF C THEN YEAR = "2018";
	ELSE IF D THEN YEAR = "2019";
RUN;

%INC "~LOCATION OF THE CHISPOOING MACRO\CHISPOOLING.sas";

%CHISPOOLING(DATAIN = COMBINED, DATAOUT = COMBINED, YEARLIST = 2015_16 2017 2018 2019, PREFIX = FNWGT);

PROC SURVEYFREQ DATA = COMBINED;
WEIGHT FNWGT0;
REPWEIGHT FNWGT1-FNWGT&REPN./1;
TABLE INS;
RUN;

