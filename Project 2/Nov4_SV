    VARMETHOD=JACKKNIFE;

    WEIGHT RAKEDW0;

    REPWEIGHTS RAKEDW1-RAKEDW80 / JKCOEFS=1;

    TABLES
       
        / CL;

    FORMAT
       ;

RUN;


/* TABLE 2: Logistic regression*/

/*Crude OR*/
%MACRO crude(var, ref=1);                                  
PROC SURVEYLOGISTIC DATA = evape_recode
     VARMETHOD=JACKKNIFE;  
     WEIGHT RAKEDW0;                                      
     REPWEIGHTS RAKEDW1-RAKEDW80 / JKCOEFS=1;   
     CLASS &var (REF="&ref") / PARAM=REF;                  
     MODEL Noncigpro_excl_evape (EVENT='1') = &var;
RUN;
%MEND;

